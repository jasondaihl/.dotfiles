#!/usr/bin/env zsh
# ~/.dotfiles/zsh/zshrc
export DOTFILES="$HOME/.dotfiles"

# Core settings
setopt AUTO_CD NO_BEEP HIST_IGNORE_ALL_DUPS SHARE_HISTORY
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history
export PATH="/opt/homebrew/bin:$PATH"

# Profile: resolve from the persisted file (written by switch_profile),
# falling back to any env override, then "personal".
PROFILE_STATE="$DOTFILES/.current_profile"
if [ -z "$DOTFILES_PROFILE" ] && [ -f "$PROFILE_STATE" ]; then
  DOTFILES_PROFILE="$(cat "$PROFILE_STATE")"
fi
export DOTFILES_PROFILE="${DOTFILES_PROFILE:-personal}"

# Load profile-specific zsh configs
PROFILE_FILE="$DOTFILES/zsh/profiles/${DOTFILES_PROFILE}.zsh"
[ -f "$PROFILE_FILE" ] && source "$PROFILE_FILE"

# Persist the choice, flip the git identity, and reload the shell so the new
# profile (env + prompt) takes effect everywhere.
switch_profile() {
  case "$1" in
    personal|work)
      echo "$1" > "$PROFILE_STATE"
      git config --global include.path "$DOTFILES/git/gitconfig_$1"
      echo "Switched to $1 profile ($(git config user.email))"
      exec zsh
      ;;
    *)
      echo "Usage: switch_profile {personal|work}"
      return 1
      ;;
  esac
}

# Starship (single shared config, symlinked to ~/.config/starship.toml)
eval "$(starship init zsh)"

# Plugins
source $(brew --prefix)/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source $(brew --prefix)/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Tooling
eval "$(zoxide init zsh)"
eval "$(direnv hook zsh)"

# Modular config
source $DOTFILES/zsh/aliases.zsh
source $DOTFILES/zsh/node.zsh
source $DOTFILES/zsh/fzf.zsh
source $DOTFILES/zsh/keybindings.zsh
