# ---------------------------------------------------------------------------
# CLI tools
# ---------------------------------------------------------------------------
brew "starship"        # prompt
brew "fnm"             # node version manager
brew "pnpm"            # package manager
brew "fzf"             # fuzzy finder
brew "bat"             # cat with syntax highlighting
brew "eza"             # ls replacement (needs a Nerd Font for --icons)
brew "zoxide"          # smarter cd
brew "git-delta"       # git diff pager
brew "jq"              # JSON processor
brew "direnv"          # per-project env vars
brew "gh"              # GitHub CLI
brew "vim"
brew "pre-commit"      # git hooks / linting

# Frontend / fullstack quality-of-life
brew "ripgrep"         # fast grep (rg)
brew "fd"              # fast find, powers fzf
brew "lazygit"         # terminal git UI (pairs with delta)
brew "watchman"        # file watching (metro / some bundlers)
brew "httpie"          # friendly curl for APIs
brew "mas"             # Mac App Store CLI

# ---------------------------------------------------------------------------
# Fonts
# ---------------------------------------------------------------------------
cask "font-jetbrains-mono-nerd-font"  # renders starship / eza glyphs

# ---------------------------------------------------------------------------
# GUI apps (prune any you don't want before running `brew bundle`)
# ---------------------------------------------------------------------------
cask "visual-studio-code"
cask "iterm2"
cask "google-chrome"
cask "firefox"
cask "raycast"         # launcher
cask "rectangle"       # window management
cask "orbstack"        # fast Docker / Linux VMs (lighter than Docker Desktop)
cask "figma"           # design handoff
cask "bruno"           # open-source API client
